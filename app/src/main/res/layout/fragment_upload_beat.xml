<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0D0D0D">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="🎵 Publicar Beat" android:textColor="#FFFFFF"
            android:textSize="22sp" android:textStyle="bold" android:layout_marginBottom="20dp"/>

        <FrameLayout android:layout_width="match_parent" android:layout_height="160dp"
            android:background="#1A1A1A" android:layout_marginBottom="16dp">
            <ImageView android:id="@+id/img_cover_preview" android:layout_width="match_parent"
                android:layout_height="match_parent" android:scaleType="centerCrop"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pick_cover" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="🖼 Seleccionar portada"
                android:backgroundTint="#2A2A2A" android:textColor="#AAAAAA"
                android:layout_gravity="center" app:cornerRadius="8dp"/>
        </FrameLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Título del beat *" android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_title" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#FFFFFF"/>
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:hint="Precio (€) *" android:layout_marginEnd="8dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_price" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="numberDecimal" android:textColor="#FFFFFF"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:hint="BPM">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_bpm" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="number" android:textColor="#FFFFFF"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Género (Trap, Lo-fi, Drill...)" android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_genre" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#FFFFFF"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Descripción" android:layout_marginBottom="16dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_description" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minLines="2"
                android:inputType="textMultiLine" android:textColor="#FFFFFF"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pick_audio" android:layout_width="match_parent"
            android:layout_height="56dp" android:text="🎵 Seleccionar audio (MP3/WAV)"
            android:backgroundTint="#1A1A1A" android:textColor="#A855F7"
            app:strokeColor="#A855F7" app:strokeWidth="1dp" android:layout_marginBottom="8dp"/>

        <TextView android:id="@+id/tv_audio_name" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#888888"
            android:textSize="12sp" android:gravity="center" android:layout_marginBottom="20dp"
            android:text="Ningún archivo seleccionado"/>

        <ProgressBar android:id="@+id/progress_upload" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center"
            android:visibility="gone" android:layout_marginBottom="8dp"/>

        <TextView android:id="@+id/tv_upload_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#A855F7"
            android:textSize="13sp" android:gravity="center" android:layout_marginBottom="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_publish" android:layout_width="match_parent"
            android:layout_height="56dp" android:text="Publicar Beat"
            android:backgroundTint="#A855F7" android:textColor="#FFFFFF" android:textStyle="bold"/>
    </LinearLayout>
</ScrollView>
