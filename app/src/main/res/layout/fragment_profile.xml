<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Cover -->
        <ImageView
            android:id="@+id/iv_cover"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:scaleType="centerCrop"
            android:background="@color/bg_elevated"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Avatar — solapado sobre la cover con margen negativo -->
            <ImageView
                android:id="@+id/iv_avatar"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_avatar_circle"
                android:layout_marginTop="-42dp"/>

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"/>

            <TextView
                android:id="@+id/tv_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tv_bio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.4"/>

            <!-- Actions row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit_profile"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Editar perfil"
                    android:backgroundTint="@color/bg_elevated"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="1dp"
                    android:layout_marginEnd="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sales_history"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Mis compras"
                    android:backgroundTint="@color/bg_elevated"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="1dp"/>
            </LinearLayout>

            <!-- Actions row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_upload_beat"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="🎵 Subir beat"
                    android:backgroundTint="@color/accent"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    app:cornerRadius="14dp"
                    android:layout_marginEnd="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_upload_lyric"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="📝 Subir letra"
                    android:backgroundTint="@color/accent_dark"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    app:cornerRadius="14dp"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_logout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Cerrar Sesión"
                android:backgroundTint="@color/bg_elevated"
                android:textColor="@color/red_error"
                android:textSize="13sp"
                app:cornerRadius="14dp"
                app:strokeColor="#FF4D4D33"
                app:strokeWidth="1dp"
                android:layout_marginTop="12dp"/>

            <!-- Mis publicaciones -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mis publicaciones"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="4dp"/>

            <ProgressBar
                android:id="@+id/progress_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:indeterminateTint="@color/accent"
                android:visibility="gone"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tv_no_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aún no has subido contenido"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:visibility="gone"
                android:layout_marginTop="12dp"/>

            <!-- Beats del usuario -->
            <TextView
                android:id="@+id/tv_beats_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎵 Beats"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:visibility="gone"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_my_beats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone"
                android:layout_marginTop="6dp"/>

            <!-- Letras del usuario -->
            <TextView
                android:id="@+id/tv_lyrics_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📝 Letras"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:visibility="gone"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_my_lyrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="32dp"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
